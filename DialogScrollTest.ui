  <property name="styleSheet">
   <string notr="true">        QSlider::groove:horizontal { height: 10px; background: #DCDCDC; border-radius: 4px;}
        QSlider::sub-page:horizontal { background: #3EA8FF;  border-radius: 4px;}
        QSlider::handle:horizontal {
            width: 16px;
            height: 16px;
            margin: -5px 0;
            background: white;
            border: 2px solid #3EA8FF;
            border-radius: 10px; }

        QSlider::groove:vertical { width: 10px; background: #3EA8FF;  border-radius: 4px; }
        QSlider::sub-page:vertical { background: #DCDCDC;  border-radius: 4px; }
        QSlider::handle:vertical {
            width: 16px;
            height: 16px;
            margin: 0 -5px;
            background: white;
            border: 2px solid #3EA8FF;
            border-radius: 10px; }

        QSlider::handle:hover { background: #F0F0F0;}
        QSlider::handle:pressed { background: #E0E0E0; border-color: #2D7FD1; }</string>
