      <property name="styleSheet">
       <string notr="true">QSpinBox {
    padding-left: 10px;
    padding-right: 10px;
	background-color:#F6F6F6;
	border:2px solid #a1a1a1;
    text-align:center;
	border-radius:8px;
}
QSpinBox::up-button {
    subcontrol-position: right;
    right: 5px; /* 向左偏移（实验性，效果有限）*/

    width: 18px;
    height: 18px; 
    subcontrol-origin: border; 

    border: none;
    background-color: transparent;
    background-image: url(:/images/plug-normal.png);
    background-repeat: no-repeat;
    background-position: center;
}
QSpinBox::down-button {
    subcontrol-position: left;
    left: 5px;
    width: 18px;
    height: 18px; 
    subcontrol-origin: border; 

    border: none;
    background-color: transparent;
    background-image: url(:/images/minus-normal.png);
    background-repeat: no-repeat;
    background-position: center;
}
QSpinBox::up-button:disabled{
    background-image: url(:/images/plug-disabled.png);
}
QSpinBox::down-button:disabled{
    background-image: url(:/images/minus-disabled.png);
}</string>
